Digit=0~9;
Letter={a~z;A~Z;"_";OtherLanguageLetter};
SymbolChar={Letter;Digit};
SpaceChar= \oneof " \t\v\r\n";
Delimiter=";";
LineDelimiter={"\n";"\r\n"};
CommentPrefix="\\\\";
StringEscapePrefix="\\";

Space=SpaceChar+;
DigitLiteral=Digit+;
Symbol=\raw (Letter,SymbolChar*);
SymbolDotChain=(symbols:Symbol+ \sep ".")=>symbols;
GeneralSymbol={Symbol;SymbolDotChain};

Comment=(CommentPrefix,comment:AnyChar*,LineDelimiter?)=>comment;     \\ AnyChar with * or + always not greedy
Ignorable={Space;Comment};

EscapeChar=("\\", c:AnyChar)=>c;
StringLiteral=(text:{EscapeChar; {-EscapeChar; -"\""; AnyChar}+}* \enclosedby "\"\"")=>text;
CharRangeBound={SymbolChar;StringLiteral};
CharRange=(start:CharRangeBound, "~", end:CharRangeBound)=>[.start=start, .end=end];

FieldAssignment=(".", symbol:Symbol, "=", expr:Expr \ignore Ignorable)=>[.target=symbol, .source=expr];
Struct=(field_assignments:FieldAssignment* \sep "," \ignore Ignorable \enclosedby "[]")=>field_assignments;

CharSet = {
    CharRange;
    ("\\oneof", string:StringLiteral \sep Space)=>string
    \associateby "()"
    \ignore Ignorable
};

GreedyQuantifier=\oneof "?+*";
NonGreedyQuantifier=\raw (GreedyQuantifier,"^");
PostfixOp={NonGreedyQuantifier;GreedyQuantifier};
PrefixOp={"\\raw"; "-"};
PatternWithUnaryOp=(prefix_op:PrefixOp?, pattern:Pattern, postfix_op:PostfixOp? \ignore Ignorable)=>[.prefix_op=prefix_op, .pattern=pattern, .postfix_op=postfix_op];
TopLevelPattern=PatternWithUnaryOp;

AssociateByPart=("\\associateby", pattern:Pattern \ignore Ignorable)=>pattern;
PatternSet=((patterns:{PatternBinding;TopLevelPattern}* \sep ";" \ignore Ignorable),
    ";"?,
    associateby_part:AssociateByPart?, 
    ignore_part:IgnorePart? 
    \ignore Ignorable \enclosedby "{}")=>[.patterns=patterns, .associateby=associateby_part, .ignore=ignore_part];

SepPart=("\\sep", pattern:Pattern \ignore Ignorable)=>pattern;
IgnorePart=({"\\ignore_include_beginning";"\\ignore"}, pattern:Pattern \ignore Ignorable)=>pattern;
EnclosedbyPart=("\\enclosedby", pattern:Pattern \ignore Ignorable)=>pattern;        \\ valid pattern is StringLiteral of length 2 or PatternSeq of length 2
PatternSeq=(
    (patterns:{PatternBinding;TopLevelPattern}+ \sep "," \ignore Ignorable), 
    sep_part:SepPart?, ignore_part:IgnorePart?, enclosedby_part:EnclosedbyPart? 
    \ignore Ignorable
    \enclosedby "()"
)=>[.patterns=patterns, .sep=sep_part, .ignore=ignore_part, .enclosedby=enclosedby_part];

PatternBinding=(symbol:Symbol,":",pattern:TopLevelPattern \ignore Ignorable)=>[.symbol=symbol, .pattern=pattern];
Rule=(pattern:PatternSeq,"=>",returned:Expr)=>[.pattern=pattern, .returned=returned];

Pattern={Rule;PatternSeq;PatternSet;CharSet;StringLiteral;GeneralSymbol \associateby "()" \ignore Ignorable};

List=(exprs:Expr* \sep "," \ignore Ignorable \enclosedby "[]")=>exprs;

Assignment = (symbol:Symbol, "=", pattern:TopLevelPattern \ignore Ignorable)=>[.target=symbol, .source=pattern];

Expr={
    Assignment;
    List;
    Struct;
    TopLevelPattern;
    GeneralSymbol;
};

Keyword={
    "\\oneof"; 
    "\\sep"; "\\ignore"; "\\enclosedby"; "\\ignore_include_beginning";
    "\\associateby";
    "\\raw";  \\ raw represents raw text within matched text
};

Synx=(exprs:Expr* \sep ";" \ignore_include_beginning Ignorable)=>[.exprs=exprs];
